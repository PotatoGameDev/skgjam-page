<h1>Stream Calendar</h1>

<p>
	Who is streaming which jam submissions, and when. Upcoming streams are listed first.
</p>

<p id="tz-note" class="tz-note" data-streams-url="{{ '/assets/streams.json' | toBaseUrl }}"></p>
<ul id="stream-list" class="stream-list"></ul>

<script>
(function () {
	var streamsUrl = document.getElementById("tz-note").getAttribute("data-streams-url");
	var listEl = document.getElementById("stream-list");
	var tzNote = document.getElementById("tz-note");
	var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;

	tzNote.textContent = "Times are shown in your local timezone (" + tz + ").";

	fetch(streamsUrl)
		.then(function (r) {
			if (!r.ok) throw new Error("missing");
			return r.json();
		})
		.then(render)
		.catch(function () {
			listEl.textContent = "No stream list file available yet.";
		});

	function endMs(s) {
		return new Date(s.start).getTime() + (s.lengthHours || 0) * 3600000;
	}

	function render(streams) {
		var now = Date.now();
		var upcoming = streams
			.filter(function (s) { return endMs(s) >= now; })
			.sort(function (a, b) { return new Date(a.start) - new Date(b.start); });
		var past = streams
			.filter(function (s) { return endMs(s) < now; })
			.sort(function (a, b) { return new Date(b.start) - new Date(a.start); });

		if (!streams.length) {
			listEl.textContent = "No streams scheduled yet.";
			return;
		}

		if (upcoming.length) {
			listEl.appendChild(heading("Upcoming"));
			upcoming.forEach(function (s) { listEl.appendChild(renderItem(s)); });
		}
		if (past.length) {
			listEl.appendChild(heading("Past"));
			past.forEach(function (s) { listEl.appendChild(renderItem(s)); });
		}
	}

	function heading(text) {
		var h = document.createElement("h2");
		h.textContent = text;
		return h;
	}

	function renderItem(s) {
		var li = document.createElement("li");
		var startedMs = new Date(s.start).getTime();
		var ended = endMs(s) < Date.now();
		if (ended) li.className = "past";

		var date = new Intl.DateTimeFormat(undefined, {
			dateStyle: "medium"
		}).format(new Date(s.start));

		li.appendChild(document.createTextNode(s.streamer + " - " + date));
		if (s.title) {
			li.appendChild(document.createTextNode(" - " + s.title));
		}
		if (s.lengthHours) {
			li.appendChild(document.createTextNode(" (" + durationLabel(s.lengthHours) + ")"));
		}
		if (ended) {
			li.appendChild(document.createTextNode(" (ended)"));
		} else if (startedMs <= Date.now()) {
			li.appendChild(document.createTextNode(" (live)"));
		}

		var links = [];
		if (s.youtube) links.push(makeLink(s.youtube, "YouTube"));
		if (s.twitch) links.push(makeLink(s.twitch, "Twitch"));
		if (links.length) {
			li.appendChild(document.createTextNode(" - "));
			links.forEach(function (a, i) {
				if (i > 0) li.appendChild(document.createTextNode(", "));
				li.appendChild(a);
			});
		}

		return li;
	}

	function durationLabel(hours) {
		return hours === 1 ? "1 hour" : hours + " hours";
	}

	function makeLink(href, label) {
		var a = document.createElement("a");
		a.href = href;
		a.target = "_blank";
		a.rel = "noopener";
		a.textContent = label;
		return a;
	}
})();
</script>
